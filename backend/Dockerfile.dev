FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

WORKDIR /app

# Install both runtime and dev dependencies (pytest, ruff, etc.).
COPY pyproject.toml uv.lock* ./
RUN uv sync --frozen --no-cache --group dev

COPY . .

EXPOSE 8000

CMD ["/app/.venv/bin/adk", "web", "--host", "0.0.0.0", "--port", "8000", "."]
