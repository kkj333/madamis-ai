# コピー: cp .env.example .env
# Gemini は Vertex AI（ADC）のみ。ローカルでは gcloud auth application-default login

GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# gemini-3-flash-preview は Vertex 上で global のみ
GOOGLE_CLOUD_LOCATION=global

# 省略時 gemini-3-flash-preview
# GEMINI_MODEL=gemini-3-flash-preview

# ADK session persistence. Omit or set in_memory for local ephemeral sessions.
# ADK_SESSION_SERVICE=firestore
# FIRESTORE_PROJECT_ID=
# FIRESTORE_DATABASE_ID=(default)
# ADK_FIRESTORE_ROOT_COLLECTION=adk-session

# 省略時 INFO。詳細ログは DEBUG
# LOG_LEVEL=DEBUG
